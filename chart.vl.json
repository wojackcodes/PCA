{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "width": 400, "height": 200, "padding": 5,
  "data": [{"name": "table", "values": [
    {"category": "A", "amount": 28}, {"category": "B", "amount": 55}
  ]}],
  "scales": [
    {"name": "xscale", "type": "band", "domain": {"data": "table", "field": "category"},
     "range": "right", "padding": 0.1},
    {"name": "yscale", "type": "linear", "domain": {"data": "table", "field": "amount"},
     "range": "height", "nice": true}
  ],
  "axes": [{"orient": "bottom", "scale": "xscale"}, {"orient": "left", "scale": "yscale"}],
  "marks": [{
    "type": "rect", "from": {"data": "table"},
    "encode": {"enter": {
      "x": {"scale": "xscale", "field": "category"},
      "width": {"scale": "xscale", "band": 1},
      "y": {"scale": "yscale", "field": "amount"},
      "y2": {"scale": "yscale", "value": 0}
    }}
  }]
}
